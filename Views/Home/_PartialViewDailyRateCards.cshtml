@model IList<GeneralAdmission>
@{
    var showCaption = ViewData["ShowCaption"] as bool? == true;
    var col = showCaption
        ? "col-12 col-sm-6 col-md-4 mb-3"
        : "col-6 col-sm-5 col-md-4 col-lg-3 col-xl-2 col-xxl-2 mb-2";
    var priceSize = showCaption ? "3.5rem" : "6rem";
    var supSize = showCaption ? "1.75rem" : "3rem";
}
<div class="row d-sm-flex d-xxl-flex justify-content-center text-center">
    @foreach (var item in Model)
    {
        <div class="@col" data-aos="flip-right" data-aos-duration="1500" data-aos-once="true">
            <div class="popup-div text-center h-100" style="border-radius: 20px;">
                <text style="font-size: @priceSize; white-space: nowrap;">
                    <sup style="font-size: @supSize;">$</sup>@Money.Display(item.GAPrice)
                </text>
                <h3 style="font-size: 20px;color: rgb(239,108,0);">@item.GAName</h3>
                @if (showCaption && !string.IsNullOrWhiteSpace(item.GAInclusion))
                {
                    <p class="px-3 pb-3 mb-0" style="font-size: 14px;color: var(--bs-body-color);">@item.GAInclusion</p>
                }
            </div>
        </div>
    }
</div>
